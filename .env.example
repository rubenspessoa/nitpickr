# Sentry (optional — leave unset to disable; SDK no-ops without a DSN)
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Core runtime
DATABASE_URL=postgres://nitpickr:nitpickr@db:5432/nitpickr
NITPICKR_BASE_URL=https://your-public-host
NITPICKR_WEBHOOK_URL=https://your-public-host/webhooks/github
NITPICKR_SECRET_KEY=replace-with-a-long-random-secret

# OpenAI (or any OpenAI-compatible endpoint — see "Local models" below)
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_BASE_URL=https://api.openai.com/v1
# Prefer gpt-5-mini for cost-effective reviews. If your account does not have
# access, set this to another supported model such as gpt-4.1.
OPENAI_MODEL=gpt-5-mini
# Chat model for the memory classifier (small prompts). Defaults to gpt-4o-mini.
# OPENAI_MEMORY_MODEL=gpt-4o-mini
# Embedding model for memory recall. Set to "off" to disable embeddings
# (memory then ranks by keyword + recency only). Defaults to text-embedding-3-small.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vector width of the embedding model; must match OPENAI_EMBEDDING_MODEL
# (text-embedding-3-small = 1536, nomic-embed-text = 768). Changing it re-shapes
# the memories.embedding column on the next migrate and clears stored vectors.
# NITPICKR_EMBEDDING_DIMENSIONS=1536
# Sent as `reasoning_effort` (none|minimal|low|medium|high). Leave unset for
# models that do not support it.
# OPENAI_REASONING_EFFORT=
# Per-request timeout for every model call (default 300000 = 5 min).
# OPENAI_REQUEST_TIMEOUT_MS=300000
# Max model requests in flight for one review (chunk fan-out). Default 4.
# NITPICKR_MODEL_MAX_CONCURRENT_REQUESTS=4
# Total prompt characters (patch + file content) packed per review chunk.
# Lower this for models with small context windows or slow prefill. Default 200000.
# NITPICKR_REVIEW_CHUNK_MAX_TOTAL_CHARS=200000

# Local models via Ollama (example — uncomment and adjust)
# Ollama exposes an OpenAI-compatible API; the API key is required by nitpickr
# but ignored by Ollama. From Docker Compose, reach the host's Ollama through
# host.docker.internal. Serialize requests: Ollama handles one at a time.
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=qwen3.6:35b-a3b-nvfp4
# OPENAI_REASONING_EFFORT=none
# OPENAI_MEMORY_MODEL=qwen3.6:35b-a3b-nvfp4
# OPENAI_EMBEDDING_MODEL=nomic-embed-text
# NITPICKR_EMBEDDING_DIMENSIONS=768
# OPENAI_REQUEST_TIMEOUT_MS=1800000
# NITPICKR_MODEL_MAX_CONCURRENT_REQUESTS=1
# NITPICKR_REVIEW_CHUNK_MAX_TOTAL_CHARS=160000
# NITPICKR_JOB_STALE_AFTER_MS=3600000
# NITPICKR_WORKER_CONCURRENCY=1

# GitHub App
GITHUB_APP_ID=<GITHUB_APP_ID>
GITHUB_API_BASE_URL=https://api.github.com
# Comma-separated mention handles without '@'. Usually your GitHub App name.
GITHUB_BOT_LOGINS=nitpickr,getnitpickr
# Store the private key in your secret manager. Do not commit real keys.
# If you must use a single-line env var, use '\n' escapes for newlines.
GITHUB_PRIVATE_KEY=<GITHUB_APP_PRIVATE_KEY>
# Generate a random secret and keep it out of source control.
GITHUB_WEBHOOK_SECRET=<GITHUB_WEBHOOK_SECRET>

# Runtime tuning
PORT=3000
NITPICKR_LOG_LEVEL=info
NITPICKR_WORKER_CONCURRENCY=4
NITPICKR_WORKER_POLL_INTERVAL_MS=5000
NITPICKR_JOB_STALE_AFTER_MS=900000
NITPICKR_WORKER_HEARTBEAT_INTERVAL_MS=5000
NITPICKR_READY_WORKER_STALE_AFTER_MS=15000

# Optional limits
# NITPICKR_REPOSITORY_ALLOWLIST=owner/repo-a,owner/repo-b
# NITPICKR_PROMPT_OPTIMIZATION_MODE=balanced
# DISCORD_WEBHOOK_URL=
